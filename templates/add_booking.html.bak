{% extends "base.html" %}

{% block title %}Add Booking{% endblock %}

{% block content %}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="card-title">Add Appointment</h2>
                <form method="POST" novalidate>

                    <div class="mb-3">
                        <label class="form-label">Customer Name</label>
                        <input class="form-control" type="text" name="customer_name" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Phone Number</label>
                        <input class="form-control" type="text" name="phone" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Appointment Time</label>
                        <input class="form-control" type="datetime-local" name="start_time" required>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Appointment Length (Minutes)</label>
                        <input class="form-control" type="number" name="duration" required>
                    </div>

                    <div class="row">
                        <div class="mb-3 col-md-6">
                            <label class="form-label">Room</label>
                            <select class="form-select" name="room" required>
                                <option value="Not assigned yet">Not assigned yet</option>
                                <option value="Jules">Jules</option>
                                <option value="Aly">Aly</option>
                                <option value="Amira">Amira</option>
                                <option value="Echo">Echo</option>
                                <option value="Suprani">Suprani</option>
                                <option value="Rose">Rose</option>
                                <option value="Daisy">Daisy</option>
                                <option value="Lay">Lay</option>
                            </select>
                        </div>
                        <div class="mb-3 col-md-6">
                            <label class="form-label">Paid?</label>
                            <select class="form-select" name="paid">
                                    <option value="yes">Paid</option>
                                    <option value="no">Not Paid</option>
                                    <option value="group">Group</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Location</label>
                        <input class="form-control" type="text" name="location" placeholder="e.g. Brighton Clinic">
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Save Booking</button>
                        <a href="{{ url_for('calendar') }}" class="btn btn-outline-secondary">Cancel</a>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>

{% endblock %}